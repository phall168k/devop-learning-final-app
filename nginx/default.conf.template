resolver 127.0.0.11 valid=10s ipv6=off;

upstream nest_backend {
    zone nest_backend 64k;

    server api-prod:${API_PORT} resolve;
}

upstream nuxt_frontend {
    zone nuxt_frontend 64k;
    server frontend-prod:${PORT} resolve;
}

server {
    listen 80;

    server_name ${NGINX_SERVER_NAME};

    client_max_body_size ${NGINX_MAX_BODY};

    location /api/ {
        proxy_pass http://nest_backend;

        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Nuxt Frontend
    location / {
        proxy_pass http://nuxt_frontend;

        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}